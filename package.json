{
  "name": "vbot-api",
  "version": "1.0.0",
  "description": "Production-grade API framework — Express/Koa-style routing, middleware, validators, auth, and OpenAPI generation",
  "keywords": ["api", "framework", "http", "router", "middleware", "rest", "vbot"],
  "license": "MIT",
  "author": "VBot Team <vbot@example.com>",
  "homepage": "https://github.com/vexify-org/vbot-api",
  "repository": {
    "type": "git",
    "url": "https://github.com/vexify-org/vbot-api.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node example/server.js",
    "dev": "node --watch example/server.js",
    "test": "jest"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/**/*.test.js"],
    "verbose": true
  },
  "files": [
    "src/"
  ],
  "exports": {
    ".": "./src/index.js",
    "./middleware/*": "./src/middleware/*.js",
    "./validators": "./src/validators/index.js",
    "./utils/*": "./src/utils/*.js"
  }
}
